{
  "name": "@theholocron/configs",
  "version": "8.4.4",
  "private": true,
  "description": "Shared configuration files.",
  "keywords": [
    "browserslist-config",
    "commitlint-config",
    "developer-tools",
    "eslint-config",
    "lint-staged-config",
    "nodejs",
    "prettier-config",
    "semantic-release-config",
    "shareable-configs",
    "storybook-config",
    "stylelint-config",
    "tsconfig",
    "tsdown-config",
    "vite-config",
    "vitest-config"
  ],
  "homepage": "https://docs.theholocron.dev/configs/",
  "bugs": "https://github.com/theholocron/configs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/configs.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "turbo run delivery.build",
    "delivery.build": "holocron run delivery.build --",
    "docs:build": "astro build",
    "docs:dev": "astro dev",
    "docs:preview": "astro preview",
    "holocron": "holocron",
    "knowledge.wiki": "holocron run knowledge.wiki --",
    "platform.commitStandards": "holocron run platform.commitStandards --",
    "platform.repoSync": "holocron run platform.repoSync --",
    "prepare": "turbo run delivery.build && husky",
    "security.secretDetection": "holocron run security.secretDetection --",
    "sourceQuality.deadCodeAnalysis": "holocron run sourceQuality.deadCodeAnalysis --",
    "sourceQuality.formatting": "holocron run sourceQuality.formatting --",
    "sourceQuality.staticAnalysis": "holocron run sourceQuality.staticAnalysis --",
    "sourceQuality.structuredDataValidation": "holocron run sourceQuality.structuredDataValidation --",
    "verification.typeSafety": "holocron run verification.typeSafety --",
    "verification.unitTests": "holocron run verification.unitTests --"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@theholocron/astro-config": "workspace:*",
    "@theholocron/astromech": "catalog:holocron",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/commitlint-config": "workspace:*",
    "@theholocron/components-doc": "catalog:docs",
    "@theholocron/docs-theme": "^1.3.5",
    "@theholocron/eslint-config": "workspace:*",
    "@theholocron/holocron-plugin-cloudflare": "catalog:holocron",
    "@theholocron/holocron-plugin-fern": "catalog:holocron",
    "@theholocron/holocron-plugin-github": "catalog:holocron",
    "@theholocron/lint-staged-config": "workspace:*",
    "@theholocron/prettier-config": "workspace:*",
    "@theholocron/registry-doc": "catalog:docs",
    "@theholocron/semantic-release-config": "workspace:*",
    "@theholocron/skills": "^1.3.3",
    "astro": "^7.2.2",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.10"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@commitlint/config-conventional>conventional-changelog-conventionalcommits": "7",
      "conventional-changelog-conventionalcommits": "9.3.1",
      "uuid": "^11.1.1",
      "yuku-parser": "0.6.3"
    }
  },
  "releases": "https://github.com/theholocron/configs/releases",
  "wiki": "https://github.com/theholocron/configs/wiki"
}
