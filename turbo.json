{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.json"],
  "tasks": {
    "sourceQuality.staticAnalysis": {
      "inputs": ["src/**", "eslint.config.ts", "eslint.config.js", "eslint.config.mjs", "eslint.config.cjs", "**/*.ts"],
      "outputs": [],
      "dependsOn": ["^delivery.build"]
    },
    "verification.unitTests": {
      "inputs": ["src/**", "vitest.config.ts", "vitest.config.js", "vitest.config.mjs", "package.json", "**/*.ts"],
      "outputs": ["test-report.junit.xml", "coverage/**"],
      "dependsOn": ["delivery.build", "^delivery.build"]
    },
    "verification.typeSafety": {
      "inputs": ["src/**", "tsconfig.json", "**/*.ts"],
      "outputs": [],
      "dependsOn": ["^delivery.build"]
    },
    "delivery.build": {
      "inputs": [
        "src/**",
        "package.json",
        "tsdown.config.ts",
        "vite.config.ts",
        "rollup.config.ts",
        "tsconfig.json",
        "**/*.ts"
      ],
      "outputs": ["dist/**"],
      "dependsOn": ["^delivery.build"]
    }
  }
}
